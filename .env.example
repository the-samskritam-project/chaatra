# Copy this file to .env and fill in the values you need.
# docker-compose.yml reads this file automatically for ${VAR} interpolation.
# Anything left blank is treated as "feature disabled" (the backend skips it
# at startup); the app still boots without OpenAI, Cloudinary, etc.

# ============================================================
# Backend
# ============================================================

# Server
PORT=8081

# Auth — required for signup/signin, notes, favorites, voice recordings
JWT_SECRET=
# Admin endpoints (middleware)
API_KEY=

# OpenAI — required for conversation tutor, semantic search, word analysis,
# sandhi split, whisper transcription, AI translation, verify translation
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=

# MongoDB — required for auth, notes, favorites, subhashita translations,
# conversation cache. The default URI targets the `mongodb` service inside
# docker-compose.yml; override only if you point at an external host.
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=chaatra
MONGODB_USERS_DATABASE=users
MONGODB_NOTES_DATABASE=notes
MONGODB_FAVORITES_DATABASE=favorites
MONGODB_USER_TRANSLATIONS_DATABASE=user_translations
MONGODB_VECTOR_DATABASE=vector_search

# ChromaDB — optional, required for semantic search
# (start it separately via docker-compose-chromadb.yml)
CHROMA_URL=
CHROMA_BRIDGE_URL=

# Cloudinary — required for voice recording uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional path overrides — defaults are baked into the backend image
RAMAYANA_DATA_PATH=
RAMAYANA_RARITY_PATH=

# ============================================================
# Frontend (Create React App — must be REACT_APP_*)
# ============================================================

REACT_APP_API_BASE_URL=http://localhost:8081
REACT_APP_SHOW_HITOPADESA=false
REACT_APP_SHOW_PANCATANTRA=true
