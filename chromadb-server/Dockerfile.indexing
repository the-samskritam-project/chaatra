# ChromaDB Indexing Service Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    dnsutils \
    iputils-ping \
    && rm -rf /var/lib/apt/lists/*

# Install PyTorch CPU-only first (much smaller, no CUDA)
RUN pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

# Install Python dependencies
RUN pip install --no-cache-dir \
    chromadb \
    sentence-transformers

# Pre-download the sentence transformer model during build
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('sentence-transformers/paraphrase-multilingual-mpnet-base-v2')"

# Copy build scripts and data files
COPY chromadb-server/build_chromadb.py .
COPY chromadb-server/build_chromadb_index_en.sh .
COPY chromadb-server/build_ramayana_index_en.sh .
COPY chromadb-server/parsed_dictionary.json .
COPY chromadb-server/valmiki_ramayan_shlokas_filtered.json .
RUN chmod +x *.sh

# Default command - runs both indexes with explicit logging
CMD ["/bin/bash", "-c", "set -x && echo 'Starting indexing job...' && echo 'CHROMA_SERVER_URL='$CHROMA_SERVER_URL && ./build_chromadb_index_en.sh && ./build_ramayana_index_en.sh && echo 'Indexing completed successfully!'"]

